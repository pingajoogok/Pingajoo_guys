{
  "manifest_version": 3,
  "name": "Pingajoo",
  "version": "1.5.1",
  "description": "To prevent malpractice, identifies and blocks third-party browser extensions during tests on the Iamneo portal. Also provides tools for AI responses, custom copy/paste, and keeping the window active.",
  "background": {
    "service_worker": "worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "devtools.js",
        "data/inject/f41e2811.js",
        "data/inject/9bea1669.js",
        "data/inject/222d7607.js",
        "data/inject/faa1c23d.js",
        "data/inject/9f624e52.js",
        "data/lib/showdown.min.js",
        "metadata.json",
        "background.js",
        "contentScript.js",
        "manifest.json",
        "data/inject/mock_code/manifest.json",
        "data/inject/mock_code/minifiedBackground.js",
        "data/inject/mock_code/minifiedContent-script.js",
        "data/inject/mock_code/rules.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "permissions": [
    "management",
    "tabs",
    "activeTab",
    "contextMenus",
    "clipboardWrite",
    "clipboardRead",
    "storage",
    "scripting",
    "downloads",
    "windows",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "*://*/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://firestore.googleapis.com https://*.googleapis.com https://api.github.com https://dns.google https://pingajoo-backend.onrender.com http://localhost:*"
  },
  "key": "",
  "externally_connectable": {
    "matches": [
      "http://*/*",
      "https://*/*"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "images/pingajoo_logo.png",
      "48": "images/pingajoo_logo.png",
      "128": "images/pingajoo_logo.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "data/inject/9bea1669.js",
        "data/inject/222d7607.js",
        "data/inject/dcbf3f58.js",
        "data/inject/9b96c665.js",
        "data/inject/1699ffae.js",
        "data/inject/c53c376f.js",
        "data/inject/ac451961.js",
        "data/lib/showdown.min.js",
        "contentScript.js"
      ],
      "exclude_matches": [
        "*://*.discord.com/*",
        "*://*.figma.com/*"
      ]
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "js": [
        "devtools.js"
      ]
    },
    {
      "js": [
        "data/inject/28c9f8e6.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "matchOriginAsFallback": true,
      "world": "MAIN",
      "matches": [
        "<all_urls>",
        "https://*.examly.io/*",
        "https://*.vit.ac.in/*",
        "https://app.codility.com/*"
      ],
      "exclude_matches": [
        "https://*.examly.io/result*",
        "https://*.vit.ac.in/result"
      ]
    }
  ],
  "commands": {
    "search-mcq": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "mac": "Alt+Shift+M"
      },
      "description": "Solve MCQs"
    },
    "search": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Solve MCQs"
    },
    "nptel": {
      "suggested_key": {
        "default": "Alt+Shift+N",
        "mac": "Alt+Shift+N"
      },
      "description": "nptel"
    }
  },
  "icons": {
    "16": "images/pingajoo_logo.png",
    "48": "images/pingajoo_logo.png",
    "128": "images/pingajoo_logo.png"
  },
  "version_name": "Release Version"
}